# Copy to .env and fill in only what you use. Nothing here is required for demo mode.
# Data provider: yahoo (free, no key, midpoint only) | twelvedata | oanda | mt5 | demo (synthetic, labelled DEMO)
FOREX_PROVIDER=yahoo

# Optional free-tier keys (never commit real keys)
TWELVEDATA_API_KEY=
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Database (SQLite by default; PostgreSQL later: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=

# Optional: require this token (Bearer / X-API-Key) on every API call
API_TOKEN=

# Risk / research defaults (paper trading only)
PAPER_EQUITY=10000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
NEWS_UNAVAILABLE_POLICY=warn   # warn | block
